            double3 xformOp:translate = (0, 0.42, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Xform "DistanceLabels"
        {
            custom double dgn2:robot_to_source_m = 1.0322791531363986
            custom double dgn2:robot_to_table_m = 0.9035485598461215
            custom double dgn2:source_to_placement_m = 0.75
