            def BasisCurves "RobotToTable"
            {
                int[] curveVertexCounts = [2]
                point3f[] points = [(0, 0.42, 0.8), (0, 0, 0)]
                color3f[] primvars:displayColor = [(0.95, 0.15, 0.1)]
                uniform token type = "linear"
                float[] widths = [0.006, 0.006]
            }

            def BasisCurves "RobotToSource"
            {
                int[] curveVertexCounts = [2]
                point3f[] points = [(0, 0.42, 0.8), (-0.5, 0, 0.0005)]
                color3f[] primvars:displayColor = [(0.1, 0.35, 0.95)]
                uniform token type = "linear"
                float[] widths = [0.006, 0.006]
            }

            def BasisCurves "SourceToPlacement"
